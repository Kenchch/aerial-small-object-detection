* text=auto
.mailmap text eol=lf

# Binary assets -- never diff or line-ending convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pt binary
*.onnx binary
*.pdf binary

# Self-contained report bundles, not hand-written source -- exclude from
# GitHub's language detection so it reports the Python in src/, not this HTML.
reports/*.html linguist-generated=true
