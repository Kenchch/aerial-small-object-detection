# Developed on Windows; text files are already CRLF throughout, so keep that
# instead of git's default LF normalization (avoids renormalization churn).
* text=auto eol=crlf

# Binary assets -- never diff or line-ending convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pt binary
*.onnx binary
*.pdf binary

# Self-contained report bundles, not hand-written source -- exclude from
# GitHub's language detection so it reports the Python in src/, not this HTML.
reports/*.html linguist-generated=true
